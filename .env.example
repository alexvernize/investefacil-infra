# Template de variáveis de ambiente para desenvolvimento local.
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.

# ── Backend Go ───────────────────────────────────────────────────────────────
# Lidas pelo backend Go e pelo docker-compose (env_file). Ajuste antes do deploy.
# ALLOWED_ORIGIN: nunca use '*'. Em produção, use a URL real do frontend com https://.
PORT=8080
ALLOWED_ORIGIN=http://localhost:3000

# Para deploy atrás de load balancer, liste os CIDRs do proxy (separados por vírgula):
# TRUSTED_PROXIES=10.0.0.0/8

# ── Variáveis futuras (banco de dados, autenticação) ─────────────────────────
# DATABASE_URL=postgres://user:senha@localhost:5432/investefacil
# JWT_SECRET=trocar-por-segredo-forte-em-producao

# ── AWS (só necessário para Terraform local, não para docker compose) ─────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=sa-east-1
